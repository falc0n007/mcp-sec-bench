# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Runner output.
# results/raw/ is deliberately NOT ignored: docs/governance.md commits to
# committing raw scanner output for every published run, so anyone can check
# our arithmetic and our mappings without rerunning anything. Scratch runs go
# under results/local/ instead.
results/local/
results/*.local.json
.scanner-tokens

# Held-back corpus (never committed to the public repo)
corpus/private/

# OS / editor
.DS_Store
.idea/
.vscode/
